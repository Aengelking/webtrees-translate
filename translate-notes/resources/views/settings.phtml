                $limit     = (int) ($usage['limit'] ?? 0);
                $count     = (int) ($usage['count'] ?? 0);
                $remaining = (int) ($usage['remaining'] ?? 0);
                $percent   = $limit > 0 ? (int) round($count / $limit * 100) : 0;
            ?>
            <?php if ($limit > 0) : ?>
                <p class="mb-1">
                    <strong><?= I18N::number($remaining) ?></strong>
                    <?= I18N::translate('of %s characters remaining this period', I18N::number($limit)) ?>

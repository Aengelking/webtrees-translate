                     aria-valuenow="<?= $percent ?>" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar <?= $percent >= 90 ? 'bg-danger' : ($percent >= 75 ? 'bg-warning' : '') ?>"
                         style="width: <?= $percent ?>%;"><?= $percent ?>%</div>
                </div>
                <div class="form-text">
                    <?= I18N::translate('%1$s of %2$s characters used.', I18N::number($count), I18N::number($limit)) ?>
                </div>
            <?php else : ?>
                <p class="mb-0"><?= I18N::translate('Your DeepL plan reports no character limit (unlimited).') ?></p>
                <div class="form-text"><?= I18N::translate('%s characters used.', I18N::number($count)) ?></div>
            <?php endif ?>
        <?php elseif (!empty($usage['error'])) : ?>
            <div class="alert alert-warning mb-0">
                <?= I18N::translate('Could not retrieve usage from DeepL:') ?> <?= e($usage['error']) ?>
            </div>
        <?php else : ?>
            <p class="text-muted mb-0"><?= e($usage['reason'] ?? '') ?></p>
        <?php endif ?>
    </div>
</div>

<div class="row mb-3">
